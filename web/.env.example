# 이 파일을 `.env.local`로 복사해서 쓴다(.env.local은 *.local 규칙으로 이미 gitignore됨).
# ⚠ HCX/NCP API Key는 여기에도, .env.local에도 넣지 않는다 — 프론트 번들은 전부 공개된다.

# 목(MSW) 서버 사용 여부. 기본 켜짐 — 값을 넣지 않으면 켜진 것으로 본다.
# 백엔드(FastAPI)를 붙였으면 false로 끈다. 자세한 건 src/mocks/README.md
VITE_ENABLE_MSW=true

# API 서버 주소. 비워 두면 같은 오리진으로 요청한다(= 목이 가로챈다).
# 목을 끄고 로컬 백엔드를 볼 때만 채운다. 예: http://localhost:8000
VITE_API_BASE=
