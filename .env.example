CLOVA_STUDIO_API_KEY=
CLOVA_MODEL=HCX-DASH-002

# query_classifier.classify_intent()가 씀 — 없으면 모든 예외를 삼키고 informational로
# 조용히 폴백해 civil_petition 경로가 아예 실행되지 않는다(에러 없이 조용히 실패).
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5.4-mini

# Supabase Postgres (Transaction pooler — IPv4, 대부분 네트워크에서 접속 가능)
# Supabase 대시보드 > Connect > Type: Transaction pooler 에서 확인
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
