CLOVA_STUDIO_API_KEY=
CLOVA_MODEL=HCX-DASH-002

# query_planner.plan_query()(멀티쿼리 분해 + intent 분류를 한 번의 structured-output 호출로
# 처리)와 폴백 경로 query_classifier.classify_intent()가 씀 — 없으면 모든 예외를 삼키고
# 분해 없이 informational로 조용히 폴백한다(에러 없이 조용히 실패).
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5.6-luna

# Supabase Postgres (Transaction pooler — IPv4, 대부분 네트워크에서 접속 가능)
# Supabase 대시보드 > Connect > Type: Transaction pooler 에서 확인
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ─── FastAPI 백엔드(api/) 전용 ─────────────────────────────────────────────
# 전부 선택 항목이다. 값을 안 주면 api/config.py 의 기본값이 쓰인다.
# 접두사 API_ 는 위쪽 src/ 용 변수와 이름이 섞이지 않게 하려고 붙인다.

# development | production. production 이면 /docs, /openapi.json 이 닫힌다.
# API_ENVIRONMENT=development
# API_DEBUG=false

# React 개발 서버 주소. 콤마로 여러 개(기본: localhost:3000, localhost:5173)
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RAG 한 번의 최대 대기 시간(초). 복합 질문은 LLM 을 여러 번 부른다.
# API_RAG_TIMEOUT_S=120
# API_SSE_PING_INTERVAL_S=15

# 클라이언트당 분당 요청 수(프로세스 메모리 기반, 워커별로 따로 셈)
# API_RATE_LIMIT_ENABLED=true
# API_RATE_LIMIT_PER_MINUTE=30
# 프록시/로드밸런서 뒤에 배포할 때만 true (직접 노출 시 켜면 우회 가능)
# API_TRUST_PROXY_HEADERS=false

# 앱 시작 시 검색엔진·임베딩 모델을 미리 로드(첫 질문 지연 제거).
# 개발 중 재시작이 잦으면 false 로 끄면 빨리 뜬다.
# API_WARMUP_ON_STARTUP=true
